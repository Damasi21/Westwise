SECRET_KEY=troque-esta-chave
OMIE_CREDENTIALS_ENCRYPTION_KEY=use-uma-chave-longa-e-estavel
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

OMIE_API_TIMEOUT=90
OMIE_API_RETRIES=3
OMIE_API_RETRY_DELAY=2
OMIE_API_REDUNDANT_DELAY=60
OMIE_API_REDUNDANT_BUFFER=5

# sqlite ou postgres
DATABASE_ENGINE=sqlite

# Usado somente quando DATABASE_ENGINE=postgres
POSTGRES_DB=west_bi
POSTGRES_USER=west_user
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
POSTGRES_CONNECT_TIMEOUT=10

# E-mail para recuperacao de senha
# Em desenvolvimento, o padrao imprime os e-mails no console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.seudominio.com.br
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@seudominio.com.br
EMAIL_HOST_PASSWORD=troque-esta-senha
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@seudominio.com.br
